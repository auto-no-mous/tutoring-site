# Переменные для docker-compose.yml (кладите рядом с ним как .env).
# Пароль базы: compose подставляет его и в сервис postgres, и в DATABASE_URL
# backend'а с bot'ом. Придумайте длинный случайный - наружу порт 5432 не
# публикуется, но пароль всё равно единственная защита базы внутри хоста:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Необязательные - имеют разумные значения по умолчанию.
# POSTGRES_USER=mytutor
# POSTGRES_DB=mytutor
