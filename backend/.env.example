ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./storage/db.sqlite3

JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Свой Postfix на хосте (прод, см. ops/mail/README.md):
#   SMTP_HOST=host.docker.internal, SMTP_PORT=25, без логина/пароля, SMTP_STARTTLS=false
# Внешний провайдер: SMTP_HOST=smtp.example.com, SMTP_PORT=587, логин/пароль, STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM=no-reply@my-tutor.ru
MAIL_FROM_NAME=my-tutor.ru
# Куда попадут ответы пользователей на письма сайта (no-reply@ никто не читает).
MAIL_REPLY_TO=info@my-tutor.ru
EMAIL_ENABLED=false
# Секрет для приёма входящих писем в журнал (генерирует ops/mail/install.sh).
MAIL_INGEST_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Bootstrap credentials read by `poetry run python -m app.scripts.create_admin` when
# --email/--password aren't passed explicitly.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# In-memory per-IP rate limiting on /auth/* (see app/core/rate_limit.py). Leave on;
# only ever disabled by the test suite itself.
RATE_LIMIT_ENABLED=true

# Optional error tracking (app/core/logging.py) - inert unless set, no Sentry
# dependency added by leaving this blank.
SENTRY_DSN=
