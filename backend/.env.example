ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./storage/db.sqlite3

JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@my-tutor.ru
EMAIL_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Bootstrap credentials read by `poetry run python -m app.scripts.create_admin` when
# --email/--password aren't passed explicitly.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# In-memory per-IP rate limiting on /auth/* (see app/core/rate_limit.py). Leave on;
# only ever disabled by the test suite itself.
RATE_LIMIT_ENABLED=true

# Optional error tracking (app/core/logging.py) - inert unless set, no Sentry
# dependency added by leaving this blank.
SENTRY_DSN=
